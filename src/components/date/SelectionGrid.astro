---
import Icon from "@src/components/Icon.astro";

interface Option {
  value: string;
  label: string;
}

interface Props {
  name: string;
  options: Option[];
  nextUrl: string;
  nextLabel: string;
  backUrl?: string;
  backLabel?: string;
}

const { name, options, nextUrl, nextLabel, backUrl, backLabel } = Astro.props;
---

<selection-grid
  data-name={name}
  data-next={nextUrl}
  data-back={backUrl}
  class="selection-grid-content"
>
  <div class="grid-wrapper">
    {
      options.map((opt) => (
        <label class="selection-element transition" for={opt.value}>
          <input
            id={opt.value}
            type="checkbox"
            name={name}
            value={opt.value}
            class="custom-checkbox transition"
          />
          <span class="text">{opt.label}</span>
        </label>
      ))
    }
  </div>

  <div class="navigation-buttons">
    {
      backUrl && (
        <a
          id="back-button"
          class="btn secondary-button transition"
          href={backUrl}
          data-astro-prefetch
        >
          <Icon icon="arrow-left" size="20px" />
          {backLabel}
        </a>
      )
    }

    <a
      id="next-button"
      class="btn primary-button transition"
      href={nextUrl}
      data-astro-prefetch
    >
      {nextLabel}
      <Icon icon="arrow-right" size="20px" />
    </a>
  </div>
</selection-grid>

<script>
  class SelectionGrid extends HTMLElement {
    connectedCallback() {
      const name = this.dataset.name;
      const nextUrl = this.dataset.next;
      const backUrl = this.dataset.back;

      if (!name || !nextUrl) return;

      const inputs = this.querySelectorAll<HTMLInputElement>(
        'input[type="checkbox"]',
      );
      const nextBtn = this.querySelector<HTMLAnchorElement>("#next-button");
      const backBtn = this.querySelector<HTMLAnchorElement>("#back-button");

      const params = new URLSearchParams(window.location.search);
      const selectedValues = params.get(name)?.split(",") || [];

      inputs.forEach((input) => {
        if (selectedValues.includes(input.value)) {
          input.checked = true;
        }
      });

      nextBtn?.addEventListener("click", (e) => {
        e.preventDefault();
        const currentParams = new URLSearchParams(window.location.search);

        const checkedValues = Array.from(inputs)
          .filter((i) => i.checked)
          .map((i) => i.value);

        if (checkedValues.length > 0) {
          currentParams.set(name, checkedValues.join(","));
        } else {
          currentParams.delete(name);
        }

        window.location.href = `${nextUrl}?${currentParams.toString()}`;
      });

      backBtn?.addEventListener("click", (e) => {
        e.preventDefault();
        window.location.href = `${backUrl}${window.location.search}`;
      });
    }
  }

  customElements.define("selection-grid", SelectionGrid);
</script>

<style>
  .selection-grid-content {
    width: 100%;
  }

  .grid-wrapper {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 20px;
    margin-top: 40px;
    margin-bottom: 40px;
  }

  .selection-element {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing, 4px) * 3);
    padding: calc(var(--spacing, 4px) * 3) calc(var(--spacing, 4px) * 4);
    border-radius: var(--radius-lg, 12px);
    border: 2px solid var(--gray-300);
    cursor: pointer;
    background: transparent;
  }

  .selection-element:has(.custom-checkbox:checked) {
    border-color: var(--primary-regular);
    background-color: color-mix(
      in srgb,
      var(--primary-regular) 10%,
      transparent
    );
  }

  .custom-checkbox {
    appearance: none;
    -webkit-appearance: none;
    width: 24px;
    height: 24px;
    border: 2px solid var(--gray-300, #e2e8f0);
    border-radius: 6px;
    outline: none;
    display: grid;
    place-content: center;
    margin: 0;
    cursor: pointer;
  }

  .custom-checkbox::before {
    content: "";
    width: 12px;
    height: 12px;
    border-radius: 2px;
    transform: scale(0);
    transition: transform 0.2s ease-in-out;
    background-color: var(--primary-regular, #3b82f6);
  }

  .custom-checkbox:checked {
    border-color: var(--primary-regular, #3b82f6);
  }

  .custom-checkbox:checked::before {
    transform: scale(1);
  }

  .navigation-buttons {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }
</style>
