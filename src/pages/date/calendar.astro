---
import DateLayout from "@layouts/DateLayout.astro";
import DateCard from "@src/components/date/DateCard.astro";
import { previousAndNext } from "@src/components/date/items";
import Icon from "@src/components/Icon.astro";
import { getTranslations, type LanguageKey } from "@src/i18n/ui";

const lang = Astro.currentLocale as LanguageKey;
const t = getTranslations(lang);

const { next, back } = previousAndNext("calendar");

let nextUrl: string | undefined;
let backUrl: string | undefined;

if (next) {
  nextUrl = `/date/${next}`;
}
if (back) {
  backUrl = `/date/${back}`;
}

let currentDate = new Date();
currentDate.setTime(0);

const excludedDates = [];
---

<DateLayout
  title={t.date.questionCalendar}
  description={t.date.questionCalendar}
>
  <DateCard step="calendar">
    <h1 id="name">{t.date.questionCalendar}</h1>

    <!-- TODO: embed the calendar element instead of text box? + apply simple formatting - eg. rounded corners -->
    <label for="date">
      {t.date.chooseDate}:
      <input
        id="date"
        type="date"
        value={currentDate.toISOString()}
        min={currentDate.toISOString()}
      />
      <!-- TODO: min date should be current date, and max date should be about 6 months in the future?  -->
    </label>
    <!-- TODO: handle a constant list of dates that shouldn't have any dates scheduled at that date - because I've got some other things to do -->

    <!-- TODO: do the same as with the date picker -->
    <label for="time">
      {t.date.chooseTime}:
      <input id="time" type="time" />
    </label>
    <!-- TODO: on weekends (saturday, sunday) I'm available all the time - anytime works -->
    <!-- TODO: but on workdays I'm available only after 17:00 -->
    <!-- TODO: and another thing on tuesdays I ride to Warsaw for work - and I'm not coming back until at least 18:00 -->

    <div class="navigation-buttons">
      {
        backUrl && (
          <a
            id="back-button"
            class="btn secondary-button transition"
            href={backUrl}
            data-astro-prefetch
          >
            <Icon icon="arrow-left" size="20px" />
            {t.date.back}
          </a>
        )
      }

      <a
        id="next-button"
        class="btn primary-button transition"
        href={nextUrl}
        data-astro-prefetch
      >
        {t.date.next}
        <Icon icon="arrow-right" size="20px" />
      </a>
    </div>
  </DateCard>
</DateLayout>

<script>
  import { previousAndNext } from "@src/components/date/items";

  const { next, back } = previousAndNext("calendar");

  let nextUrl: string | undefined;
  let backUrl: string | undefined;

  if (next) {
    nextUrl = `/date/${next}`;
  }
  if (back) {
    backUrl = `/date/${back}`;
  }

  // TODO: we need to add a script that will listen to date/time changes and automatically apply
  // changes to the query parameters in the current url as well as the buttons next + back

  const updateButtonHrefs = (searchParams: URLSearchParams) => {
    const nextBtn = this.querySelector<HTMLAnchorElement>("#next-button");
    const backBtn = this.querySelector<HTMLAnchorElement>("#back-button");

    const searchStr = searchParams.toString();
    const suffix = searchStr ? `?${searchStr}` : "";

    if (nextBtn) {
      nextBtn.href = `${nextUrl}${suffix}`;
    }
    if (backBtn && backUrl) {
      backBtn.href = `${backUrl}${suffix}`;
    }
  };

  const initialParams = new URLSearchParams(window.location.search);
  const selectedDate = initialParams.get("date");
  const selectedTime = initialParams.get("time");

  const currentParams = initialParams; // TODO: update these

  const newSearch = currentParams.toString();
  const newUrl = `${window.location.pathname}${newSearch ? "?" + newSearch : ""}`;

  window.history.replaceState(window.history.state, "", newUrl);

  updateButtonHrefs(initialParams);
</script>

<style>
  .navigation-buttons {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }
</style>
