---
import DateLayout from "@layouts/DateLayout.astro";
import DateCard from "@src/components/date/DateCard.astro";
---

<DateLayout
  title="Will you be my girlfriend?"
  description="Will you be my girlfriend?"
>
  <DateCard step="calendar">
    <h1 id="name">{}</h1>
  </DateCard>
</DateLayout>

<script>
  const urlSearchParams = new URLSearchParams(window.location.search);
  const params = Object.fromEntries(urlSearchParams.entries());

  const element = document.getElementById("name");
  if (element) {
    element.textContent = params.name || "Will you be my girlfriend?";
  }
</script>

<style></style>
