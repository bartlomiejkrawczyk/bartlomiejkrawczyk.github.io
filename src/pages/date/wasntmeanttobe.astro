---
import DateLayout from "@layouts/DateLayout.astro";
import DateCard from "@src/components/date/DateCard.astro";
import { getTranslations, type LanguageKey } from "@src/i18n/ui";
import { Image } from "astro:assets";

import logo from "@assets/sad-penguin.svg";
import Icon from "@src/components/Icon.astro";

const lang = Astro.currentLocale as LanguageKey;
const t = getTranslations(lang);

let backUrl: string = "/date/dealBreakers";
---

<DateLayout title={t.date.wasntMeantToBe} description={t.date.wasntMeantToBe}>
  <DateCard step="seeyousoon">
    <h1 id="name" class="text">{t.date.wasntMeantToBe}</h1>
    <Image
      src={logo}
      width={300}
      height={300}
      alt="Cute penguin waving its flipper"
    />

    <h2 class="text">{t.date.reconsider}</h2>

    <div class="navigation-buttons">
      <a
        id="back-button"
        class="btn secondary-button transition"
        href={backUrl}
        data-astro-prefetch
      >
        <Icon icon="arrow-left" size="20px" />
        {t.date.back}
      </a>
    </div>
  </DateCard>
</DateLayout>

<script>
  const backUrl = "/date/dealBreakers";

  const updateButtonHrefs = (searchParams: URLSearchParams) => {
    const backBtn = document.querySelector<HTMLAnchorElement>("#back-button");
    const searchStr = searchParams.toString();
    const suffix = searchStr ? `?${searchStr}` : "";

    if (backBtn && backUrl) {
      backBtn.href = `${backUrl}${suffix}`;
    }
  };

  const initialParams = new URLSearchParams(window.location.search);
  updateButtonHrefs(initialParams);
</script>

<style>
  .navigation-buttons {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 24px;
  }

  .btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .text {
    text-align: center;
  }
</style>
