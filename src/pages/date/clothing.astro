---
import DateLayout from "@layouts/DateLayout.astro";
import DateCard from "@src/components/date/DateCard.astro";
import SelectionGrid from "@src/components/date/SelectionGrid.astro";
import { getTranslations, type LanguageKey } from "@src/i18n/ui";

const lang = Astro.currentLocale as LanguageKey;
const t = getTranslations(lang);

const clothingKeys = ["casual", "elegant"] as const;

const clothingOptions = clothingKeys.map((key) => ({
  value: key,
  label: t.date.clothing[key],
}));
---

<DateLayout
  title={t.date.questionClothing}
  description={t.date.questionClothing}
>
  <DateCard current={4} pages={5}>
    <h1 id="name" style="text-align: center;">{t.date.questionClothing}</h1>

    <SelectionGrid
      name="clothing"
      options={clothingOptions}
      nextUrl="/date/present"
      nextLabel={t.date.next}
      backUrl="/date/activity"
      backLabel={t.date.back}
      type="radio"
    />
  </DateCard>
</DateLayout>
