---
import DateLayout from "@layouts/DateLayout.astro";
import DateCard from "@src/components/date/DateCard.astro";
import SelectionGrid from "@src/components/date/SelectionGrid.astro";
import { getTranslations, type LanguageKey } from "@src/i18n/ui";

const lang = Astro.currentLocale as LanguageKey;
const t = getTranslations(lang);

const payingKeys = ["men", "feminist", "sugarMommy", "wildcard"] as const;

type Paying = (typeof payingKeys)[number];

const payingIcons: Partial<Record<Paying, string>> = {};

const payingOptions = payingKeys.map((key) => ({
  value: key,
  label: t.date.paying[key],
  icon: payingIcons[key],
}));

// const step = "paying";
const step = "seeyousoon";
---

<DateLayout title={t.date.questionPaying} description={t.date.questionPaying}>
  <DateCard step={step}>
    <h1 id="name" style="text-align: center;">{t.date.questionPaying}</h1>

    <SelectionGrid name={step} options={payingOptions} type="radio" />
  </DateCard>
</DateLayout>
