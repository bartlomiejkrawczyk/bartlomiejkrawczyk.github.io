---
import DateLayout from "@layouts/DateLayout.astro";
import DateCard from "@src/components/date/DateCard.astro";
import SelectionGrid from "@src/components/date/SelectionGrid.astro";
import { getTranslations, type LanguageKey } from "@src/i18n/ui";

const lang = Astro.currentLocale as LanguageKey;
const t = getTranslations(lang);

const activityKeys = [
  "cycling",
  "rollerblading",
  "kayaking",
  "bowling",
  "pool",
  "swimming",
  "cinema",
  "netflix",
  "car",
] as const;

type Activity = (typeof activityKeys)[number];

const activityIcons: Partial<Record<Activity, string>> = {
  cycling: "🚲",
  rollerblading: "🛼",
  kayaking: "🛶",
  bowling: "🎳",
  pool: "🎱",
  swimming: "🏊",
  cinema: "🎬",
  netflix: "🍿",
  car: "🚗",
};

const activityOptions = activityKeys.map((key) => ({
  value: key,
  label: t.date.activity[key],
  icon: activityIcons[key],
}));
---

<DateLayout
  title={t.date.questionActivity}
  description={t.date.questionActivity}
>
  <DateCard current={3} pages={5}>
    <h1 id="name" style="text-align: center;">{t.date.questionActivity}</h1>

    <SelectionGrid
      name="activity"
      options={activityOptions}
      nextUrl="/date/clothing"
      nextLabel={t.date.next}
      backUrl="/date/food"
      backLabel={t.date.back}
    />
  </DateCard>
</DateLayout>
