---
import DateLayout from "@layouts/DateLayout.astro";
import DateCard from "@src/components/date/DateCard.astro";
import Icon from "@src/components/Icon.astro";
import { getTranslations, type LanguageKey } from "@src/i18n/ui";

const lang = Astro.currentLocale as LanguageKey;
const t = getTranslations(lang);

const backUrl = "/date/dealBreakers";
---

<script is:inline define:vars={{ backUrl }}>
  const searchParams = new URLSearchParams(window.location.search);
  const dealBreakers = searchParams.get("dealBreakers");

  if (dealBreakers && dealBreakers !== "no") {
    window.location.replace(`/date/wasntmeanttobe?${searchParams.toString()}`);
  }
</script>

<DateLayout title={t.date.seeYouSoon} description={t.date.seeYouSoon}>
  <DateCard step="seeyousoon">
    <h1 id="name">{t.date.seeYouSoon}</h1>

    <div class="summary-box">
      <h2>{t.date.dateDetails}</h2>
      <ul id="summary-list"></ul>
    </div>

    <div class="action-buttons">
      <button id="copy-button" class="btn primary-button transition">
        <Icon icon="copy" size="20px" />
        {t.date.copy}
      </button>

      <a id="email-button" class="btn primary-button transition" href="#">
        <Icon icon="envelope" size="20px" />
        {t.date.email}
      </a>
    </div>

    <div class="navigation-buttons">
      <a
        id="back-button"
        class="btn secondary-button transition"
        href={backUrl}
        data-astro-prefetch
      >
        <Icon icon="arrow-left" size="20px" />
        {t.date.back}
      </a>
    </div>
  </DateCard>
</DateLayout>

<script>
  import { getTranslations } from "@src/i18n/ui";

  const lang = window.getLanguage?.() ?? "pl";
  const t = getTranslations(lang);

  const backUrl = "/date/dealBreakers";

  const updateButtonHrefs = (searchParams: URLSearchParams) => {
    const backBtn = document.querySelector<HTMLAnchorElement>("#back-button");
    const searchStr = searchParams.toString();
    const suffix = searchStr ? `?${searchStr}` : "";

    if (backBtn && backUrl) {
      backBtn.href = `${backUrl}${suffix}`;
    }
  };

  const initialParams = new URLSearchParams(window.location.search);
  updateButtonHrefs(initialParams);

  const getParam = (key: string) => {
    const val = initialParams.get(key);
    if (val && val.includes(",")) {
      return val.split(",").join(", ");
    }
    return val || null;
  };

  let details: any = {};

  details[t.date.date] = getParam("date");
  details[t.date.time] = getParam("time");
  details[t.date.locationName] = getParam("location");
  details[t.date.activityName] = getParam("activity");
  details[t.date.foodName] = getParam("food");
  details[t.date.clothingName] = getParam("clothing");
  details[t.date.presentName] = getParam("present");
  details[t.date.payingName] = getParam("paying");

  const summaryList = document.getElementById("summary-list");
  if (summaryList) {
    Object.entries(details).forEach(([key, value]) => {
      if (value !== null) {
        const li = document.createElement("li");
        li.innerHTML = `<strong>${key}:</strong> <span class="capitalize">${value}</span>`;
        summaryList.appendChild(li);
      }
    });
  }

  const messageLines = Object.entries(details)
    .filter(([_, value]) => value !== null)
    .map(([key, value]) => `- ${key}: ${value}`);

  const fullMessage = `${t.date.dateDetailsText}:\n\n${messageLines.join("\n")}\n\n${t.date.seeYouSoon}!`;

  const emailBtn = document.getElementById("email-button") as HTMLAnchorElement;
  if (emailBtn) {
    const subject = encodeURIComponent("Our Date Details 📅");
    const body = encodeURIComponent(fullMessage);
    emailBtn.href = `mailto:bartlomiejkrawczyk01@gmail.com?subject=${subject}&body=${body}`;
  }

  const copyBtn = document.getElementById("copy-button") as HTMLButtonElement;
  if (copyBtn) {
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(fullMessage);

        const originalHtml = copyBtn.innerHTML;
        copyBtn.innerHTML = `Copied!`;

        setTimeout(() => {
          copyBtn.innerHTML = originalHtml;
        }, 2000);
      } catch (err) {
        console.error("Failed to copy text: ", err);
        alert("Failed to copy to clipboard.");
      }
    });
  }
</script>

<style>
  .summary-box {
    background-color: var(--gray-999);
    border: 1px solid var(--gray-700);
    border-radius: 8px;
    padding: 20px;
    margin: 20px 0;
    text-align: left;
  }

  .summary-box h3 {
    margin-top: 0;
    margin-bottom: 12px;
    font-size: 1.2rem;
  }

  #summary-list {
    list-style-type: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .capitalize {
    text-transform: capitalize;
  }

  .action-buttons {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    margin: 24px 0;
  }

  .navigation-buttons {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 24px;
  }

  .btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    cursor: pointer;
  }
</style>
