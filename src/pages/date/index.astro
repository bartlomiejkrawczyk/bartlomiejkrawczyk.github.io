---
import DateLayout from "@layouts/DateLayout.astro";
import DateCard from "@src/components/date/DateCard.astro";

const name = Astro.url.searchParams.get("name") || "";

console.log(Astro.url.searchParams);
---

<DateLayout
  title="Will you be my girlfriend?"
  description="Will you be my girlfriend?"
>
  <DateCard>
    <h1 id="name" class="text">{name}</h1>

    <h3 class="text">Will you go on a date with me?</h3>

    <div id="responseButtons" class="response-buttons">
      <div class="bounce">
        <button id="yesButton" class="yes-button transition"> Yes </button>
      </div>

      <div id="noButton" class="transition">
        <button id="" class="no-button glitch"> No </button>
      </div>
    </div>
  </DateCard>
</DateLayout>

<style>
  .text {
    text-align: center;
  }

  .response-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(6 * var(--spacing));
    position: relative;
  }

  .yes-button {
    background-color: var(--primary-dark);
    color: var(--gray-999);
    border-radius: var(--radius-md);
    padding-block: calc(var(--spacing) * 3);
    padding-inline: calc(var(--spacing) * 6);
    font-size: var(--text-lg);
    line-height: var(--tw-leading, var(--text-lg--line-height));
  }
  .yes-button:hover {
    color: var(--primary-light);
    box-shadow: var(--shadow-md);
  }
  .no-button {
    background-color: var(--primary-light);
    box-shadow: var(--shadow-md);
    color: var(--gray-999);
    border-radius: var(--radius-md);
    padding-block: calc(var(--spacing) * 3);
    padding-inline: calc(var(--spacing) * 6);
    font-size: var(--text-lg);
    line-height: var(--tw-leading, var(--text-lg--line-height));
  }
  .no-button:hover {
    color: var(--gray-900);
    box-shadow: var(--shadow-md);
  }

  .bounce {
    animation: bounce 2s ease infinite;
  }

  @keyframes bounce {
    0%,
    20%,
    50%,
    80%,
    100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-10px);
    }
    60% {
      transform: translateY(-5px);
    }
  }

  .glitch {
    animation: glitch-squish 3s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
  }

  @keyframes glitch-chaos {
    0%,
    20%,
    50%,
    80%,
    90% {
      transform: translate(0, 0) scale(1);
      filter: hue-rotate(0deg);
    }
    92% {
      transform: translate(-4px, 3px) scale(0.98);
      filter: hue-rotate(90deg);
    }
    94% {
      transform: translate(4px, -3px) scale(1.02);
      filter: hue-rotate(180deg);
    }
    96% {
      transform: translate(-2px, -4px) scale(0.99);
      filter: hue-rotate(270deg);
    }
    98% {
      transform: translate(2px, 4px) scale(1.01);
      filter: hue-rotate(360deg);
    }
    100% {
      transform: translate(0, 0) scale(1);
      filter: hue-rotate(0deg);
    }
  }

  @keyframes glitch-squish {
    0%,
    70% {
      transform: scale(1, 1);
      filter: hue-rotate(0deg);
    }
    72% {
      transform: skew(70deg);
      filter: hue-rotate(90deg);
    }
    75% {
      transform: scale(0.02, 1.2);
      filter: hue-rotate(180deg);
    }
    78% {
      transform: skew(-70deg);
      filter: hue-rotate(270deg);
    }
    80% {
      transform: scale(1, 1);
      filter: hue-rotate(360deg);
    }
  }

  .ripple {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    transform: scale(0);
    animation: ripple-effect 0.6s linear;
    pointer-events: none;
  }

  @keyframes ripple-effect {
    to {
      transform: scale(4);
      opacity: 0;
    }
  }
</style>

<script>
  const urlSearchParams = new URLSearchParams(window.location.search);
  const params = Object.fromEntries(urlSearchParams.entries());

  const element = document.getElementById("name") as HTMLElement;
  if (element) {
    element.textContent = params.name || "Will you be my girlfriend?";
  }
</script>

<script>
  import confetti from "canvas-confetti";
  const responseButtons = document.getElementById(
    "responseButtons",
  ) as HTMLElement;
  const yesButton = document.getElementById("yesButton") as HTMLButtonElement;
  const noButton = document.getElementById("noButton") as HTMLButtonElement;
  const buttons = document.getElementById("responseButtons") as HTMLElement;
  //   const question = document.getElementById("valentineQuestion");

  let scale = 1;
  let growths = 0;

  const MAX_GROWTH = 5;
  const GROWTH_COOLDOWN = 500;

  let lastGrowthTime = 0;

  function growYes() {
    const now = Date.now();

    if (growths >= MAX_GROWTH) return;
    if (now - lastGrowthTime < GROWTH_COOLDOWN) return;

    lastGrowthTime = now;
    growths++;
    scale += 0.25;

    yesButton.style.transform = `scale(${scale})`;
  }

  function moveNoButton(pointerX: number, pointerY: number) {
    const rect = noButton.getBoundingClientRect();

    const centerX = rect.left + rect.width / 2;
    const centerY = rect.top + rect.height / 2;

    let dx = centerX - pointerX;
    let dy = centerY - pointerY;

    let distance = Math.hypot(dx, dy);

    if (distance < 1) {
      const angle = Math.random() * Math.PI * 2;

      dx = Math.cos(angle);
      dy = Math.sin(angle);

      distance = 1;
    } else {
      dx /= distance;
      dy /= distance;
    }

    const fingerRadius = 50;

    const moveDistance = Math.max(rect.width, rect.height) + fingerRadius * 2;

    const x = dx * moveDistance;

    const y = dy * moveDistance;

    noButton.style.transform = `translate(${x}px, ${y}px)`;

    growYes();
  }

  function handlePointerMove(e: PointerEvent) {
    const rect = noButton.getBoundingClientRect();

    const padding = 80;

    const near =
      e.clientX >= rect.left - padding &&
      e.clientX <= rect.right + padding &&
      e.clientY >= rect.top - padding &&
      e.clientY <= rect.bottom + padding;

    if (!near) return;

    moveNoButton(e.clientX, e.clientY);
  }

  function handleNoPointerDown(e: PointerEvent) {
    e.preventDefault();
    e.stopPropagation();

    moveNoButton(e.clientX, e.clientY);
  }

  document.addEventListener("pointermove", handlePointerMove);

  noButton.addEventListener("pointerdown", handleNoPointerDown);

  yesButton.addEventListener("click", (e) => {
    // question.textContent = "Yayyy! 😘";
    buttons.style.display = "none";
    confetti();
  });
</script>
